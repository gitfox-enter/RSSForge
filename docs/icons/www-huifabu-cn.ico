  var btn=document.getElementById('memberCenterBtn');
  if(!btn)return;
  btn.onclick=function(){window.location.href='/member.php';};
})();

// ========== 退出登录 ==========
(function(){
  var btn=document.getElementById('logoutBtn');
  if(!btn)return;
  btn.onclick=function(){
    if(!confirm('确定要退出登录吗？'))return;
    fetch('/api/logout',{method:'POST'}).then(function(){window.location.reload();}).catch(function(){window.location.reload();});
  };
})();

// ========== 注册/登录弹窗 ==========
(function(){
  // 工具函数
  function openModal(id){var m=document.getElementById(id);if(m)m.classList.add('show')}
  function closeModal(id){var m=document.getElementById(id);if(m)m.classList.remove('show')}

  // 注册按钮
  var regBtn=document.getElementById('registerBtn');
  var loginBtn=document.getElementById('loginBtn');
  if(regBtn)regBtn.onclick=function(){
    if(!window.XB_REG_OPEN){
      alert('注册功能暂未开放，请联系管理员');
      return;
    }
    openModal('registerModal');
  };
  if(loginBtn)loginBtn.onclick=function(){openModal('loginModal')};

  // 关闭按钮
  var regClose=document.getElementById('registerClose');
  var loginClose=document.getElementById('loginClose');
  if(regClose)regClose.onclick=function(){closeModal('registerModal')};
  if(loginClose)loginClose.onclick=function(){closeModal('loginModal')};

  // 点击遮罩关闭
  var regModal=document.getElementById('registerModal');
  var loginModal=document.getElementById('loginModal');
  if(regModal)regModal.onclick=function(e){if(e.target===regModal)closeModal('registerModal')};
  if(loginModal)loginModal.onclick=function(e){if(e.target===loginModal)closeModal('loginModal')};

  // 弹窗间切换
  var regToLogin=document.getElementById('regToLogin');
  var loginToRegister=document.getElementById('loginToRegister');
  if(regToLogin)regToLogin.onclick=function(e){e.preventDefault();closeModal('registerModal');openModal('loginModal')};
  if(loginToRegister)loginToRegister.onclick=function(e){e.preventDefault();closeModal('loginModal');openModal('registerModal')};

  // 显示错误
  function showError(id,msg){var el=document.getElementById(id);if(el){el.textContent=msg;el.style.display=msg?'block':'none'}}

  // 注册提交
  var regSubmit=document.getElementById('regSubmitBtn');
  if(regSubmit){
    regSubmit.onclick=function(){
      var u=document.getElementById('regUsername').value.trim();
      var n=document.getElementById('regNickname').value.trim();
      var p=document.getElementById('regPassword').value;
      showError('regError','');
      if(!u){showError('regError','请输入用户名');return}
      if(!p||p.length<6){showError('regError','密码至少6位');return}
      regSubmit.disabled=true;
      regSubmit.textContent='注册中…';
      fetch('/api/register',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({username:u,password:p,nickname:n})
      }).then(function(r){return r.json()}).then(function(d){
        regSubmit.disabled=false;
        regSubmit.textContent='注册';
        if(d.error){showError('regError',d.error);return}
        window.location.reload();
      }).catch(function(){
        regSubmit.disabled=false;
        regSubmit.textContent='注册';
        showError('regError','网络错误，请重试');
      });
    };
    // 回车提交
    document.getElementById('regPassword').addEventListener('keydown',function(e){if(e.key==='Enter')regSubmit.click()});
  }

  // 登录提交
  var loginSubmit=document.getElementById('loginSubmitBtn');
  if(loginSubmit){
    loginSubmit.onclick=function(){
      var u=document.getElementById('loginUsername').value.trim();
      var p=document.getElementById('loginPassword').value;
      showError('loginError','');
      if(!u){showError('loginError','请输入用户名');return}
      if(!p){showError('loginError','请输入密码');return}
      loginSubmit.disabled=true;
      loginSubmit.textContent='登录中…';
      fetch('/api/login',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({username:u,password:p})
      }).then(function(r){return r.json()}).then(function(d){
        loginSubmit.disabled=false;
        loginSubmit.textContent='登录';
        if(d.error){showError('loginError',d.error);return}
        window.location.reload();
      }).catch(function(){
        loginSubmit.disabled=false;
        loginSubmit.textContent='登录';
        showError('loginError','网络错误，请重试');
      });
    };
    document.getElementById('loginPassword').addEventListener('keydown',function(e){if(e.key==='Enter')loginSubmit.click()});
  }
})();

// ========== 屏蔽分类（登录用户服务端，游客本地） ==========
(function(){
  var btn=document.getElementById('settingsBtn');
  var modal=document.getElementById('settingsModal');
  var close=document.getElementById('settingsClose');
  var saveBtn=document.getElementById('saveBlockedCatsBtn');
  if(!btn||!modal)return;

  function getLocal(){try{return JSON.parse(localStorage.getItem('xb-blocked')||'[]')}catch(e){return []}}
  function saveLocal(v){localStorage.setItem('xb-blocked',JSON.stringify(v))}

  btn.onclick=function(){modal.classList.add('show')};
  if(close)close.onclick=function(){modal.classList.remove('show')};
  modal.onclick=function(e){if(e.target===modal)modal.classList.remove('show')};

  // 游客模式：从 localStorage 加载
  var serverBlocked=window.XB_BLOCKED_CATS||[];
  if(serverBlocked.length===0&&window.XB_LOGGED_IN===false){
    var blocked=getLocal();
    modal.querySelectorAll('[data-block-cat]').forEach(function(cb){
      cb.checked=blocked.indexOf(cb.getAttribute('data-block-cat'))===-1;
    });
    modal.querySelectorAll('[data-block-cat]').forEach(function(cb){
      cb.onchange=function(){
        var cat=cb.getAttribute('data-block-cat');
        var list=getLocal();
        var idx=list.indexOf(cat);
        if(!cb.checked&&idx===-1)list.push(cat);
        if(cb.checked&&idx!==-1)list.splice(idx,1);
        saveLocal(list);
        reloadList();
      };
    });
  } else {
    // 登录用户：即时保存到服务端
    modal.querySelectorAll('[data-block-cat]').forEach(function(cb){
      cb.onchange=function(){
        var cats=[];
        modal.querySelectorAll('[data-block-cat]:not(:checked)').forEach(function(c){
          cats.push(c.getAttribute('data-block-cat'));
        });
        fetch('/api/blocked-cats',{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({cats:cats})
        }).then(function(r){return r.json()}).then(function(){
          reloadList();
        }).catch(function(){});
      };
    });
  }

  // 保存按钮（仅登录用户显示时可用）
  if(saveBtn){
    saveBtn.onclick=function(){
      var cats=[];
      modal.querySelectorAll('[data-block-cat]:not(:checked)').forEach(function(c){
        cats.push(c.getAttribute('data-block-cat'));
      });
      if(window.XB_LOGGED_IN){
        saveBtn.textContent='保存中…';
        saveBtn.disabled=true;
        fetch('/api/blocked-cats',{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({cats:cats})
        }).then(function(r){return r.json()}).then(function(){
          saveBtn.textContent='✓ 已保存';
          saveBtn.disabled=false;
          reloadList();
          setTimeout(function(){saveBtn.textContent='保存设置'},2000);
        }).catch(function(){
          saveBtn.textContent='保存失败';
          saveBtn.disabled=false;
          setTimeout(function(){saveBtn.textContent='保存设置'},2000);
        });
      } else {
        saveLocal(cats);
        saveBtn.textContent='✓ 已保存';
        reloadList();
        setTimeout(function(){saveBtn.textContent='保存设置'},2000);
      }
    };
  }

  function reloadList(){
    var si=document.getElementById('s');
    var q=si?si.value.toLowerCase().trim():'';
    var active=document.querySelector('.cat-pill.on');
    if(active&&typeof currentCat!=='undefined'){
      currentCat=active.getAttribute('data-cat')||'all';
    }
    if(typeof loadPage==='function')loadPage(1,q||null,false);
  }
})();
(function(){
  var btn=document.getElementById('searchBtn');
  var modal=document.getElementById('searchModal');
  var close=document.getElementById('searchClose');
  var input=document.getElementById('searchModalInput');
  var mainInput=document.getElementById('s');
  if(!btn||!modal)return;
  btn.onclick=function(){
    modal.classList.add('show');
    if(input)input.value=mainInput?mainInput.value:'';
    setTimeout(function(){if(input)input.focus()},100);
  };
  close.onclick=function(){modal.classList.remove('show')};
  modal.onclick=function(e){if(e.target===modal)modal.classList.remove('show')};
  if(input){
    input.addEventListener('keydown',function(e){
      if(e.key==='Enter'){
        if(mainInput)mainInput.value=input.value;
        mainInput.dispatchEvent(new Event('input'));
        modal.classList.remove('show');
      }
    });
  }
})();
(function(){
  var BASE=API_BASE+'/rank?key=';
  var cache={},cur='yixiaoshi';
  var tabs=document.getElementById('rankTabs');
  var lst=document.getElementById('rankLst');
  function esc(s){var d=document.createElement('div');d.textContent=s;return d.innerHTML}
  function render(items){
    if(!items||!items.length){lst.innerHTML='<div class="emp">暂无数据</div>';return}
    var h='';
    for(var i=0;i<items.length;i++){
      var it=items[i],cat=it.cat_slug||'other';
      h+='<a class="rank-r" href="/?q='+encodeURIComponent(it.title)+'" data-rank-q="'+esc(it.title)+'">'
        +'<span class="rank-no">'+(i+1)+'</span>'
        +'<div class="rank-bd"><div class="rank-tt">'+esc(it.title)+'</div>'
        +'<div class="rank-meta"><span class="rank-cmt">💬 '+(it.comments||'0')+'</span>'
        +(it.catename?'<span class="rank-cate">'+esc(it.catename)+'</span>':'')
        +(it.shorttime?'<span class="rank-tm">'+esc(it.shorttime)+'</span>':'')
        +'</div></div><span class="rank-ar">›</span></a>';
    }
    lst.innerHTML=h;
  }
  function load(key){
    cur=key;
    if(cache[key]){render(cache[key]);return}
    lst.innerHTML='<div class="loading"><div class="spinner"></div>加载中…</div>';
    fetch(BASE+key).then(function(r){return r.json()}).then(function(d){
      cache[key]=d;
      if(cur===key)render(d);
    }).catch(function(){lst.innerHTML='<div class="emp">加载失败</div>'});
  }
  tabs.addEventListener('click',function(e){
    var t=e.target.closest('.rank-tab');
    if(!t)return;
    tabs.querySelectorAll('.rank-tab').forEach(function(b){b.classList.remove('on')});
    t.classList.add('on');
    load(t.getAttribute('data-key'));
  });
  load('yixiaoshi');
  // 排行榜点击：在本页触发全站搜索，不跳新页面
  lst.addEventListener('click',function(e){
    var a=e.target.closest('.rank-r');
    if(!a)return;
    e.preventDefault();
    var q=a.getAttribute('data-rank-q');
    if(!q)return;
    var si=document.getElementById('s');
    if(si)si.value=q;
    si.dispatchEvent(new Event('input'));
  });
})();
(function(){
  var BASE=API_BASE+'/rank?key=';
  var cache={},cur='shierxiaoshi';
  var tabs=document.getElementById('longRankTabs');
  var lst=document.getElementById('longRankLst');
